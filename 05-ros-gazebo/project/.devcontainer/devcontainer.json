{
    "name": "ROS Development Container",
    "privileged": true,
    "remoteUser": "vscode",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers/features/desktop-lite:1": {
            "password": "vscode",
            "webPort": "6080",
            "vncPort": "5901"
        }
    },
    "customizations": {
        "vscode": {
            "extensions":[
                // C++ Extensions
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools-extension-pack",

                // Python Stack
                "ms-python.python",

                // ROS Extensions
                "ms-iot.vscode-ros",
            ]
        }
    },
    "containerEnv": {
        "ROS_DOMAIN_ID": "42",
        "ROS_VERSION": "kilted",
        // TODO: Update to Jetty
        "GZ_VERSION": "harmonic"
    },
    "runArgs": [
        "--net=host",
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],
    "mounts": [
        "source=${localWorkspaceFolder}/.cache,target=/home/rosuser/.cache,type=bind"
    ],
    "onCreateCommand": ".devcontainer/init.sh"
}
